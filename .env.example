# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (optional)
STRIPE_SECRET_KEY=sk_live_...

# Google OAuth (optional — needed for Calendar + Gmail)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# File system scope (colon-separated paths)
FILE_SCOPE_PATHS=/Users/yourname/Documents:/Users/yourname/Desktop

# Your name (used by Trillion to address you)
USER_NAME=Gary
